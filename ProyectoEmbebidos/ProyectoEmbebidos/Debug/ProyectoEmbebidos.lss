                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
000000 c012                      RJMP start
                                 .ORG 0x0006
000006 c0f9                      RJMP PCINT0_I
                                 .ORG 0x00A
00000a c142                      RJMP PCINT2_I
                                 .ORG 0x0012
000012 c196                      RJMP overflow_handler1
                                 start:
                                 	;Configuración de las entradas y salidas
000013 e30e                          LDI R16, 0b00111110
000014 b904                      	OUT DDRB, R16
000015 e000                      	LDI R16, 0x00
000016 b907                      	OUT DDRC, R16
000017 e00e                      	LDI R16, 0b00001110
000018 b90a                      	OUT DDRD, R16
                                 	;Inicializamos en vector de interrupciones
000019 e008                      	LDI	R16,HIGH(RAMEND);Puntero de pila en el final de 
00001a bf0e                      	OUT	SPH,R16	    ;la memoria SRAM
00001b ef0f                      	LDI	R16,LOW(RAMEND)	
00001c bf0d                      	OUT	SPL,R16
                                 	;Configuración Reloj 2
00001d e004                      	LDI R16, 0x04 ;Escala 64
00001e 9300 00b1                 	STS TCCR2B, R16
                                 	;Configuración del PWM
000020 ea02                      	LDI R16, 0XA2 
000021 9300 0080                 	STS TCCR1A, R16 ;Se activa el PWM y se inicializa el modo Fast PWM
000023 e10c                      	LDI R16, 0X1C 
000024 9300 0081                 	STS TCCR1B, R16 ;Se continua con la inicialización del modo Fast PWM y el factor de preescalamiento es 256
000026 e003                      	LDI R16, 0X03
000027 9300 0087                 	STS ICR1H, R16 ;Se carga el valor top como 1000
000029 ee08                      	LDI R16, 0XE8
00002a 9300 0086                 	STS ICR1L, R16	
                                 	;Configuración de la interrupcion PCINT0 y 2
00002c e005                      	LDI R16, 0x05
00002d 9300 0068                 	STS PCICR, R16
                                 	;Colocamos el PWM en 0
00002f e010                      	LDI R17, 0x00
000030 9310 0089                 	STS OCR1AH, R17
000032 e020                      	LDI R18, 0x00
000033 9320 0088                 	STS OCR1AL, R18	
000035 9310 008b                 	STS OCR1BH, R17	
000037 9320 008a                 	STS OCR1BL, R18
                                 	; Configuramos el UART
                                 	;Tasa de Bits (Baudios: 9600) Velocidad doble
000039 e000                      	LDI R16, 0x00
00003a 9300 00c5                 	STS UBRR0H, R16
00003c ec0f                      	LDI R16, 0xCF
00003d 9300 00c4                 	STS UBRR0L, R16
                                 	;Configuramos la comunicación en velocidad doble
00003f e202                      	LDI R16, 0x22
000040 9300 00c0                 	STS UCSR0A, R16
                                 	; Modo asíncrono, Paridad: desactivada, 1 bit de parada, enviamos 8 bits
000042 e006                      	LDI R16, 0x06
000043 9300 00c2                 	STS UCSR0C, R16
000045 9478                      	SEI
                                 	LOOP:
000046 d03a                      		RCALL DETENER; Se detienen los motores
                                 		;Activamos la transmisión y recepción
000047 27cc                      		CLR R28
000048 2722                      		CLR R18; Mensaje a enviar
                                 		;Se comparan las distancias medidas con la establecida
000049 9b32                      		SBIS PINC, 2
00004a 6024                      		ORI R18, 0b00000100; Hay un muro a la izquierda
00004b 9b31                      		SBIS PINC, 1
00004c 6022                      		ORI R18, 0b00000010; Hay un muro al frente
00004d 9b30                      		SBIS PINC, 0
00004e 6021                      		ORI R18, 0b00000001; Hay un muro a la derecha 
00004f 3027                      		CPI R18, 0x07
000050 f131                      		BREQ MODI
                                 		CONTINUAR_MODI:
000051 e118                      		LDI R17, (1<<RXEN0)|(1<<TXEN0)
000052 9310 00c1                 		STS UCSR0B, R17
                                 		;Enviamos el mensaje
000054 d014                      		RCALL PUT_TX
000055 d01a                      		RCALL GET_RX
                                 		;R28 contiene el mensaje recibido
                                 		;Controlamos la dirección de movimiento del robot
000056 ffc5                      		SBRS R28, 5; Si no se activa en bit de inicio de la carrera no se mueve
000057 c00e                      		RJMP NO_MOVIMIENTO
                                 		;Apagar UART
000058 e010                      		LDI R17, 0x00
000059 9310 00c1                 		STS UCSR0B, R17
00005b fdc2                      		SBRC R28, 2
00005c d01c                      		RCALL VERI_IZQUIERDA;Si el tercer bit está en 1 se mueve a la izquierda
00005d fdc0                      		SBRC R28, 0
00005e d01e                      		RCALL VERI_DERECHA;Si el priner bit está en 1 se mueve a la derecha
00005f fdc1                      		SBRC R28, 1
000060 d031                      		RCALL ADELANTE;Si el segundo bit está en 1 se mueve adelante
000061 fdc3                      		SBRC R28, 3
000062 d040                      		RCALL RETROCEDER;Si el cuarto bit está en 1 se mueve a la izquierda
000063 ef2f                      		LDI R18, 0xFF
000064 d004                      		RCALL PUT_TX
000065 cfe0                      		RJMP LOOP
                                 NO_MOVIMIENTO:	
000066 e02f                      	LDI R18, 0x0F
000067 d001                      	RCALL PUT_TX
000068 cfdd                      	RJMP LOOP	
                                 PUT_TX:
000069 9110 00c0                 	LDS R17, UCSR0A 
00006b ff15                      	SBRS R17, UDRE0
00006c cffc                      	RJMP PUT_TX
                                 
00006d 9320 00c6                 	STS UDR0, R18
00006f 9508                      	RET
                                 GET_RX:
000070 9110 00c0                 	LDS R17, UCSR0A
000072 ff15                      	SBRS R17, UDRE0
000073 cffc                      	RJMP GET_RX
                                 
000074 91c0 00c6                 	LDS R28, UDR0
000076 9508                      	RET
                                 MODI:
000077 e028                      	LDI R18, 0x08
000078 cfd8                      	RJMP CONTINUAR_MODI
                                 VERI_IZQUIERDA:
000079 d060                      	RCALL IZQUIERDA;Se realiza un giro de 90° a la izquierda
00007a fdc4                      	SBRC R28, 4
00007b d05e                      	RCALL IZQUIERDA;Si el quinto bit está en 1 se realiza otro giro de 90°
00007c 9508                      	RET
                                 VERI_DERECHA:
00007d d036                      	RCALL DERECHA;Se realiza un giro de 90° a la derecha
00007e fdc4                      	SBRC R28, 4
00007f d034                      	RCALL DERECHA;Si el quinto bit está en 1 se realiza otro giro de 90°
000080 9508                      	RET
                                 DETENER:
000081 93cf                      	PUSH R28
000082 e000                      	LDI R16, 0x00 ;Rueda 1 y 2 giran en el mismo senstido
000083 e010                      	LDI R17, 0x00
000084 e020                      	LDI R18, 0x00
000085 e030                      	LDI R19, 0x00;Duty cycle 0%
                                 	;Motor1
000086 9320 0089                 	STS OCR1AH, R18
000088 9330 0088                 	STS OCR1AL, R19
                                 	;Motor2
00008a 9320 008b                 	STS OCR1BH, R18
00008c 9330 008a                 	STS OCR1BL, R19
                                 	;Sentido de rotacion de motores
00008e b905                      	OUT PORTB, R16
00008f b91b                      	OUT PORTD, R17
000090 91cf                      	POP R28
000091 9508                      	RET
                                 ADELANTE:
000092 93cf                      	PUSH R28
000093 e100                      	LDI R16, 0x10 ;Rueda 1 y 2 giran en el mismo senstido
000094 e014                      	LDI R17, 0x04
000095 e023                      	LDI R18, 0x03
000096 e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
000097 ef7e                      	LDI R23, 0xFE ;Tiempo: 0.26s
000098 e04f                      	LDI R20, 0x0F ;Setpoint
000099 d153                      	RCALL CONTROL_MOTORES
00009a e100                      	LDI R16, 0x10 ;Rueda 1 y 2 giran en el mismo senstido
00009b e014                      	LDI R17, 0x04
00009c e023                      	LDI R18, 0x03
00009d e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
00009e ef7e                      	LDI R23, 0xFE ;Tiempo: 0.26s
00009f e04f                      	LDI R20, 0x0F ;Setpoint
0000a0 d14c                      	RCALL CONTROL_MOTORES
0000a1 91cf                      	POP R28
0000a2 9508                      	RET
                                 RETROCEDER:
0000a3 93cf                      	PUSH R28
                                 	;Se retrocede el robot
0000a4 e008                      	LDI R16, 0x08 ;Rueda 1 y 2 giran en el mismo senstido
0000a5 e018                      	LDI R17, 0x08
0000a6 e023                      	LDI R18, 0x03
0000a7 e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
0000a8 ef7e                      	LDI R23, 0xFE ;Tiempo: 0.26s
0000a9 e04f                      	LDI R20, 0x0F ;Setpoint
0000aa d142                      	RCALL CONTROL_MOTORES
                                 	;Se avanza nueve centimetros para centrar el robot
0000ab e100                      	LDI R16, 0x10 ;Rueda 1 y 2 giran en el mismo senstido
0000ac e014                      	LDI R17, 0x04
0000ad e023                      	LDI R18, 0x03
0000ae e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
0000af e576                      	LDI R23, 0x56 ;Tiempo: 0.09s
0000b0 e04f                      	LDI R20, 0x0F ;Setpoint
0000b1 d13b                      	RCALL CONTROL_MOTORES
0000b2 91cf                      	POP R28
0000b3 9508                      	RET
                                 DERECHA:
0000b4 93cf                      	PUSH R28
0000b5 e008                      	LDI R16, 0x08;Rueda 1 y 2 giran en sentidos contrarios
0000b6 e014                      	LDI R17, 0x04
0000b7 e023                      	LDI R18, 0x03
0000b8 ea37                      	LDI R19, 0xA7;Duty cycle 93%
0000b9 ec7d                      	LDI R23, 0xCD; 0.2s
0000ba e04f                      	LDI R20, 0x0F ;Setpoint
0000bb d131                      	RCALL CONTROL_MOTORES
0000bc e008                      	LDI R16, 0x08;Rueda 1 y 2 giran en sentidos contrarios
0000bd e014                      	LDI R17, 0x04
0000be e023                      	LDI R18, 0x03
0000bf ea37                      	LDI R19, 0xA7;Duty cycle 93%
0000c0 ec7d                      	LDI R23, 0xCD; 0.2s
0000c1 e04f                      	LDI R20, 0x0F ;Setpoint
0000c2 d12a                      	RCALL CONTROL_MOTORES
0000c3 e008                      	LDI R16, 0x08;Rueda 1 y 2 giran en sentidos contrarios
0000c4 e014                      	LDI R17, 0x04
0000c5 e023                      	LDI R18, 0x03
0000c6 ea37                      	LDI R19, 0xA7;Duty cycle 93%
0000c7 ec7d                      	LDI R23, 0xCD; 0.2s
0000c8 e04f                      	LDI R20, 0x0F ;Setpoint
0000c9 d123                      	RCALL CONTROL_MOTORES
                                 	;Se retrocede el robot para alinealo correctamente
0000ca e008                      	LDI R16, 0x08 ;Rueda 1 y 2 giran en el mismo senstido
0000cb e018                      	LDI R17, 0x08
0000cc e023                      	LDI R18, 0x03
0000cd e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
0000ce e276                      	LDI R23, 0x26 ;Tiempo: 0.04s
0000cf e04f                      	LDI R20, 0x0F ;Setpoint
0000d0 d11c                      	RCALL CONTROL_MOTORES
0000d1 e008                      	LDI R16, 0x08 ;Rueda 1 y 2 giran en el mismo senstido
0000d2 e018                      	LDI R17, 0x08
0000d3 e023                      	LDI R18, 0x03
0000d4 e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
0000d5 e276                      	LDI R23, 0x26 ;Tiempo: 0.04s
0000d6 e04f                      	LDI R20, 0x0F ;Setpoint
0000d7 d115                      	RCALL CONTROL_MOTORES
0000d8 91cf                      	POP R28
0000d9 9508                      	RET
                                 IZQUIERDA:
0000da 93cf                      	PUSH R28
0000db e100                      	LDI R16, 0x10;Rueda 1 y 2 giran en sentidos contrarios
0000dc e018                      	LDI R17, 0x08
0000dd e023                      	LDI R18, 0x03
0000de ea37                      	LDI R19, 0xA7;Duty cycle 93%
0000df ec7d                      	LDI R23, 0xCD; 0.2s
0000e0 e04f                      	LDI R20, 0x0F
0000e1 d10b                      	RCALL CONTROL_MOTORES
0000e2 e100                      	LDI R16, 0x10;Rueda 1 y 2 giran en sentidos contrarios
0000e3 e018                      	LDI R17, 0x08
0000e4 e023                      	LDI R18, 0x03
0000e5 ea37                      	LDI R19, 0xA7;Duty cycle 93%
0000e6 ec7d                      	LDI R23, 0xCD; 0.2s
0000e7 e04f                      	LDI R20, 0x0F
0000e8 d104                      	RCALL CONTROL_MOTORES
0000e9 e100                      	LDI R16, 0x10;Rueda 1 y 2 giran en sentidos contrarios
0000ea e018                      	LDI R17, 0x08
0000eb e023                      	LDI R18, 0x03
0000ec ea37                      	LDI R19, 0xA7;Duty cycle 93%
0000ed ec7d                      	LDI R23, 0xCD; 0.2s
0000ee e04f                      	LDI R20, 0x0F
0000ef d0fd                      	RCALL CONTROL_MOTORES
                                 	;Se retrocede el robot para alinealo correctamente
0000f0 e008                      	LDI R16, 0x08 ;Rueda 1 y 2 giran en el mismo senstido
0000f1 e018                      	LDI R17, 0x08
