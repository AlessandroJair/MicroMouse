0000f3 e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
0000f4 e276                      	LDI R23, 0x26 ;Tiempo: 0.04s
0000f5 e04f                      	LDI R20, 0x0F ;Setpoint
0000f6 d0f6                      	RCALL CONTROL_MOTORES
                                 	;Se retrocede el robot para alinealo correctamente
0000f7 e008                      	LDI R16, 0x08 ;Rueda 1 y 2 giran en el mismo senstido
0000f8 e018                      	LDI R17, 0x08
0000f9 e023                      	LDI R18, 0x03
0000fa e338                      	LDI R19, 0x38 ;Duty cycle 82.4%
0000fb e276                      	LDI R23, 0x26 ;Tiempo: 0.04s
0000fc e04f                      	LDI R20, 0x0F ;Setpoint
0000fd d0ef                      	RCALL CONTROL_MOTORES
0000fe 91cf                      	POP R28
0000ff 9508                      	RET
                                 PCINT0_I:
000100 93cf                      	PUSH R28
000101 93df                      	PUSH R29
000102 932f                      	PUSH R18
000103 b7df                      	IN R29, SREG
000104 93df                      	PUSH R29
                                 	;Motor 1
000105 2f28                      	MOV R18, R24
000106 9522                      	SWAP R18
000107 708f                      	ANDI R24, 0x0F
000108 7f20                      	ANDI R18, 0xF0
000109 2b82                      	OR R24, R18
00010a 9918                      	SBIC PINB, 0
00010b 6082                      	ORI R24, 0x02 ;Enconder A (valor 1)
00010c 9b18                      	SBIS PINB, 0
00010d 7f8d                      	ANDI R24, 0xFD ;Enconder A (valor 0)
00010e e0d2                      	LDI YH, HIGH($200)
00010f e0c0                      	LDI YL, LOW($200)
                                 	;Conteo de pulsos
                                 	;Motor1
000110 8128                      	LD R18, Y ;Se utiliza R24 para registrar los movimientos
000111 3120                      	CPI R18, 0x10;Sentido de giro antihorario
000112 f051                      	BREQ SUB_RUT_IN0_2
000113 3028                      	CPI R18, 0x08
000114 f031                      	BREQ SUB_RUT_IN0_1 ;Sentido de giro horario
                                 	CONT_INT_0:
000115 91df                      	POP R29
000116 bfdf                      	OUT SREG, R29
000117 912f                      	POP R18
000118 91df                      	POP R29	
000119 91cf                      	POP R28
00011a 9518                      	RETI
                                 SUB_RUT_IN0_1:
00011b d003                      	RCALL CONTEO_M1_1
00011c cff8                      	RJMP CONT_INT_0
                                 SUB_RUT_IN0_2:
00011d d01a                      	RCALL CONTEO_M1_2
00011e cff6                      	RJMP CONT_INT_0
                                 CONTEO_M1_1: 
                                 	;Se evalua en el caso que nuestro motor 1 trabaje en sentido antihorario
                                 	;Reduce el valor del conteo (horario)
00011f 3280                      	CPI R24, 0x20
000120 f089                      	BREQ RESTA_M1_1
000121 3081                      	CPI R24, 0x01
000122 f079                      	BREQ RESTA_M1_1
000123 3382                      	CPI R24, 0x32
000124 f069                      	BREQ RESTA_M1_1
000125 3183                      	CPI R24, 0x13
000126 f059                      	BREQ RESTA_M1_1
                                 	;Aumenta el valor del conteo (antihorario)
000127 3180                      	CPI R24, 0x10
000128 f039                      	BREQ SUMA_M1_1
000129 3381                      	CPI R24, 0x31
00012a f029                      	BREQ SUMA_M1_1
00012b 3082                      	CPI R24, 0x02
00012c f019                      	BREQ SUMA_M1_1
00012d 3283                      	CPI R24, 0x23
00012e f009                      	BREQ SUMA_M1_1
                                 	FIN_CONTEO_M1_1:
00012f 9508                      	RET
                                 SUMA_M1_1:
000130 9503                      	INC R16
000131 cffd                      	RJMP FIN_CONTEO_M1_1
                                 RESTA_M1_1:
000132 950a                      	DEC R16
000133 cffb                      	RJMP FIN_CONTEO_M1_1
                                 SUB_RUT_IN2_1:
000134 dfea                      	RCALL CONTEO_M1_1
000135 c02c                      	RJMP CONT_INT_2
                                 SUB_RUT_IN2_2:
000136 d001                      	RCALL CONTEO_M1_2
000137 c02a                      	RJMP CONT_INT_2
                                 CONTEO_M1_2: 
                                 	;Se evalua en el caso que nuestro motor 1 trabaje en sentido horario
                                 	;Aumenta el valor del conteo (horario)
000138 3280                      	CPI R24, 0x20
000139 f079                      	BREQ SUMA_M1_2
00013a 3081                      	CPI R24, 0x01
00013b f069                      	BREQ SUMA_M1_2
00013c 3382                      	CPI R24, 0x32
00013d f059                      	BREQ SUMA_M1_2
00013e 3183                      	CPI R24, 0x13
00013f f049                      	BREQ SUMA_M1_2
                                 	;Reduce el valor del conteo (antihorario)
000140 3180                      	CPI R24, 0x10
000141 f049                      	BREQ RESTA_M1_2
000142 3381                      	CPI R24, 0x31
000143 f039                      	BREQ RESTA_M1_2
000144 3082                      	CPI R24, 0x02
000145 f029                      	BREQ RESTA_M1_2
000146 3283                      	CPI R24, 0x23
000147 f019                      	BREQ RESTA_M1_2
000148 9508                      	RET
                                 SUMA_M1_2:
000149 9503                      	INC R16
00014a cfe4                      	RJMP FIN_CONTEO_M1_1
                                 RESTA_M1_2:
00014b 950a                      	DEC R16
00014c cfe2                      	RJMP FIN_CONTEO_M1_1
                                 PCINT2_I:
00014d 93df                      	PUSH R29
00014e 93cf                      	PUSH R28
00014f 932f                      	PUSH R18
000150 b7df                      	IN R29, SREG
000151 93df                      	PUSH R29
000152 e0d2                      	LDI YH, HIGH($200)
000153 e0c0                      	LDI YL, LOW($200)
                                 	;Motor 1
000154 2f28                      	MOV R18, R24
000155 9522                      	SWAP R18
000156 708f                      	ANDI R24, 0x0F
000157 7f20                      	ANDI R18, 0xF0
000158 2b82                      	OR R24, R18
000159 994d                      	SBIC PIND, 5
00015a 6081                      	ORI R24, 0x01 ;Enconder B (valor 1)
00015b 9b4d                      	SBIS PIND, 5
00015c 7f8e                      	ANDI R24, 0xFE ;Enconder B (valor 0)
                                 	;Motor1 actualizacion de posicion
00015d 8128                      	LD R18, Y ;Se utiliza R24 para registrar los movimientos
00015e 3120                      	CPI R18, 0x10;Sentido de giro antihorario
00015f f2b1                      	BREQ SUB_RUT_IN2_2
000160 3028                      	CPI R18, 0x08
000161 f291                      	BREQ SUB_RUT_IN2_1;Sentido de giro horario
                                 	CONT_INT_2:
                                 	;Motor 2
000162 2f29                      	MOV R18, R25
000163 9522                      	SWAP R18
000164 709f                      	ANDI R25, 0x0F
000165 7f20                      	ANDI R18, 0xF0
000166 2b92                      	OR R25, R18
000167 994e                      	SBIC PIND, 6
000168 6092                      	ORI R25, 0x02 ;Enconder A (valor 1)
000169 9b4e                      	SBIS PIND, 6
00016a 7f9d                      	ANDI R25, 0xFD ;Enconder A (valor 0)
00016b 994f                      	SBIC PIND, 7
00016c 6091                      	ORI R25, 0x01 ;Enconder B (valor 1)
00016d 9b4f                      	SBIS PIND, 7
00016e 7f9e                      	ANDI R25, 0xFE ;Enconder B (valor 0)
                                 	;Motor2
00016f 95c3                      	INC YL
000170 8128                      	LD R18, Y ;Se utiliza R25 para registrar los movimientos
000171 3024                      	CPI R18, 0x04
000172 f051                      	BREQ S_CONTEO_M2_2;Sentido de giro antihorario
000173 3028                      	CPI R18, 0x08
000174 f031                      	BREQ S_CONTEO_M2_1;Sentido de giro horario
                                 	CONT_INT_2_1:
000175 91df                      	POP R29
000176 bfdf                      	OUT SREG, R29
000177 912f                      	POP R18
000178 91cf                      	POP R28
000179 91df                      	POP R29
00017a 9518                      	RETI
                                 S_CONTEO_M2_1:
00017b d003                      	RCALL CONTEO_M2_1
00017c cff8                      	RJMP CONT_INT_2_1
                                 S_CONTEO_M2_2:
00017d d016                      	RCALL CONTEO_M2_2
00017e cff6                      	RJMP CONT_INT_2_1
                                 CONTEO_M2_1:
                                 	;Se evalua en el caso que nuestro motor 2 trabaje en sentido horario
                                 	;Aumenta el valor del conteo (horario)
00017f 3290                      	CPI R25, 0x20
000180 f079                      	BREQ SUMA_M2_1
000181 3091                      	CPI R25, 0x01
000182 f069                      	BREQ SUMA_M2_1
000183 3392                      	CPI R25, 0x32
000184 f059                      	BREQ SUMA_M2_1
000185 3193                      	CPI R25, 0x13
000186 f049                      	BREQ SUMA_M2_1
                                 	;Reduce el valor del conteo (antihorario)
000187 3190                      	CPI R25, 0x10
000188 f049                      	BREQ RESTA_M2_1
000189 3391                      	CPI R25, 0x31
00018a f039                      	BREQ RESTA_M2_1
00018b 3092                      	CPI R25, 0x02
00018c f029                      	BREQ RESTA_M2_1
00018d 3293                      	CPI R25, 0x23
00018e f019                      	BREQ RESTA_M2_1
                                 	FIN_CONTEO_M2_1:
00018f 9508                      	RET
                                 SUMA_M2_1:
000190 9513                      	INC R17
000191 cffd                      	RJMP FIN_CONTEO_M2_1
                                 RESTA_M2_1:
000192 951a                      	DEC R17
000193 cffb                      	RJMP FIN_CONTEO_M2_1
                                 CONTEO_M2_2:
                                 	;Se evalua en el caso que nuestro motor 2 trabaje en sentido antihorario
                                 	;Reduce el valor del conteo (horario)
000194 3290                      	CPI R25, 0x20
000195 f089                      	BREQ RESTA_M2_2
000196 3091                      	CPI R25, 0x01
000197 f079                      	BREQ RESTA_M2_2
000198 3392                      	CPI R25, 0x32
000199 f069                      	BREQ RESTA_M2_2
00019a 3193                      	CPI R25, 0x13
00019b f059                      	BREQ RESTA_M2_2
                                 	;Aumenta el valor del conteo (antihorario)
00019c 3190                      	CPI R25, 0x10
00019d f039                      	BREQ SUMA_M2_2
00019e 3391                      	CPI R25, 0x31
00019f f029                      	BREQ SUMA_M2_2
0001a0 3092                      	CPI R25, 0x02
0001a1 f019                      	BREQ SUMA_M2_2
0001a2 3293                      	CPI R25, 0x23
0001a3 f009                      	BREQ SUMA_M2_2
                                 	FIN_CONTEO_M2_2:
0001a4 9508                      	RET
                                 SUMA_M2_2:
0001a5 9513                      	INC R17
0001a6 cffd                      	RJMP FIN_CONTEO_M2_2
                                 RESTA_M2_2:
0001a7 951a                      	DEC R17
0001a8 cffb                      	RJMP FIN_CONTEO_M2_2
                                 overflow_handler1: ;overflow interrupt handler routine
0001a9 93df                      	PUSH R29
0001aa b7df                      	IN R29, SREG
0001ab 93df                      	PUSH R29
0001ac 95f3                      	INC R31
0001ad 91df                      	POP R29
0001ae bfdf                      	OUT SREG, R29
0001af 91df                      	POP R29
0001b0 9518                      	RETI
                                 DIVIDIR:
                                 	;Entradas: R18 (dividendo) y R29 (divisor)
                                 	;Salida: R19 (cociente)
0001b1 93df                      	PUSH R29
0001b2 2733                      	CLR R19
                                 	LOOP_DIVISION:
0001b3 172d                      	CP R18, R29
0001b4 f410                      	BRSH RESTA
0001b5 91df                      	POP R29
0001b6 9508                      	RET
                                 RESTA:
0001b7 1b2d                      	SUB R18, R29
0001b8 9533                      	INC R19
0001b9 cff9                      	RJMP LOOP_DIVISION
                                 PULSOS_MOTORES:
                                 	;Motor1: R16 y Motor2:R17
                                 	;R16 Y R17: Salida, indica la velocidad del motor en Pulsos
                                 	;Escala: 64 (1s: 977)
                                 	;Tiempo:100ms
0001ba 93df                      	PUSH R29
0001bb 937f                      	PUSH R23
0001bc 936f                      	PUSH R22
0001bd 938f                      	PUSH R24
0001be 2711                      	CLR R17
0001bf 2700                      	CLR R16
                                 	;Activamos las interrupciones con los pines PB0, PD5, PD6 y PD7
0001c0 e031                      	LDI R19, 0x01
0001c1 93e0 006b                 	STS PCMSK0,R30
0001c3 ee30                      	LDI R19, 0xE0
0001c4 93e0 006d                 	STS PCMSK2,R30
0001c6 2f3f                      	MOV R19, R31 ; Copiamos el valor del cronometro
0001c7 e6d2                      	LDI R29, 0x62
0001c8 0f3d                      	ADD R19, R29
                                 	COUNT_PULSOS:
0001c9 3f0f                      	CPI R16, 255
0001ca f0a1                      	BREQ MIN_R16
                                 	CONTINUAR_CONTEO_3:
0001cb 3f1f                      	CPI R17, 255
0001cc f0a1                      	BREQ MIN_R17
                                 	CONTINUAR_CONTEO_4:
0001cd 3f05                      	CPI R16, 245
0001ce f4a0                      	BRSH OVER_R16
                                 	CONTINUAR_CONTEO_1:
0001cf 3f15                      	CPI R17, 245
0001d0 f4a0                      	BRSH OVER_R17
                                 	CONTINUAR_CONTEO_2:
0001d1 17f7                      	CP R31, R23 ;Se verifica que no se haya excedido el valor requerido
0001d2 f4a0                      	BRSH FIN_PID 
                                 	;Se realiza un conteo durante 100ms
0001d3 17f3                      	CP R31, R19 ;Aproximadamente 100ms
0001d4 f3a0                      	BRLO COUNT_PULSOS 
                                 	;Desactivamos las interrupciones
0001d5 e0d0                      	LDI R29, 0x00
0001d6 93d0 006b                 	STS PCMSK0,R29
0001d8 93d0 006d                 	STS PCMSK2,R29
                                 	;Multiplicaciones para hallar las decimas de revolucion
                                 	FIN_PROCESS:
0001da 918f                      	POP R24
0001db 916f                      	POP R22
0001dc 917f                      	POP R23
0001dd 91df                      	POP R29
0001de 9508                      	RET 
                                 MIN_R16:
0001df e000                      	LDI R16, 0x00
0001e0 cfea                      	RJMP CONTINUAR_CONTEO_3
                                 MIN_R17:
0001e1 e000                      	LDI R16, 0x00
0001e2 cfea                      	RJMP CONTINUAR_CONTEO_4
                                 OVER_R16:
0001e3 ef05                      	LDI R16, 245
0001e4 cfea                      	RJMP CONTINUAR_CONTEO_1
                                 OVER_R17:
0001e5 ef15                      	LDI R17, 245
0001e6 cfea                      	RJMP CONTINUAR_CONTEO_2
                                 FIN_PID:
                                 	;Desactivamos las interrupciones
0001e7 e070                      	LDI R23, 0x00
0001e8 9370 006b                 	STS PCMSK0,R23
0001ea 9370 006d                 	STS PCMSK2,R23
0001ec cfed                      	RJMP FIN_PROCESS
                                 CONTROL_MOTORES:
                                 	;Motor1:R18:R19 y Motor2:R20:21
                                 	;VelocidadMotor1: R24, VelocidadMotor1: R25
                                 	;Direccion motores Motor1: R16 y Motor2: R17
                                 	;Velocidad de referencia R29
                                 	;Tiempo: R23 (1s: 977)
                                 	;Se configura según la velocidad deseada en cada motor
                                 	;Motor1
0001ed 9320 0089                 	STS OCR1AH, R18
0001ef 9330 0088                 	STS OCR1AL, R19
                                 	;Motor2
0001f1 9320 008b                 	STS OCR1BH, R18
0001f3 9330 008a                 	STS OCR1BL, R19
                                 	;Inicializamos el vector
0001f5 e0b1                      	LDI XH, HIGH($150)
0001f6 e5a0                      	LDI XL, LOW($150)
                                 	;Inicializamos los valores de errores e integrada de errores
0001f7 e020                      	LDI R18, 0x00
0001f8 932c                      	ST X, R18
0001f9 95a3                      	INC XL
0001fa 932c                      	ST X, R18
0001fb 95a3                      	INC XL
0001fc 932c                      	ST X, R18
0001fd 95a3                      	INC XL
0001fe 932c                      	ST X, R18
0001ff b905                      	OUT PORTB, R16
000200 b91b                      	OUT PORTD, R17
                                 	;Almacenamos la dirección de giro
000201 e0d2                      	LDI YH, HIGH($200)
000202 e0c0                      	LDI YL, LOW($200)
000203 8308                      	ST Y, R16
000204 95c3                      	INC YL
000205 8318                      	ST Y, R17
000206 e001                      	LDI R16, 0x01 ;Se activa la bandera
000207 9300 0070                 	STS TIMSK2, R16
000209 27ff                      	CLR R31
00020a 93f0 00b2                 	STS TCNT2, R31 ; Se reinicia el cronometro
00020c 2700                      	CLR R16
00020d 2711                      	CLR R17
00020e 27ee                      	CLR R30
00020f 2788                      	CLR R24 ;Indicadores para los encoders
000210 2799                      	CLR R25
                                 	LOOP_MOTORES:
                                 		;Se reinicia la cuenta del vector
000211 e0b1                      		LDI XH, HIGH($150)
000212 e5a0                      		LDI XL, LOW($150)
000213 e0d2                      		LDI YH, HIGH($200)
000214 e0c0                      		LDI YL, LOW($200)
                                 		;Lectura de encoder
000215 dfa4                      		RCALL PULSOS_MOTORES
000216 2f21                      		MOV R18, R17
000217 2f34                      		MOV R19, R20
000218 77ef                      		ANDI R30, 0x7F
000219 d055                      		RCALL PID_V_MOTOR
00021a 9360 0089                 		STS OCR1AH, R22
00021c 9350 0088                 		STS OCR1AL, R21
                                 		;Se controla la dirección de giro en caso de ser necesario
00021e 8128                      		LD R18, Y; Se lee el valor de direccion guardado
00021f fde2                      		SBRC R30,2
000220 d032                      		RCALL INVERTIR_DIRECCION_MOTOR1		
000221 b925                      		OUT PORTB, R18
                                 		;Se implementa la nueva salida
000222 95a3                      		INC XL
000223 95c3                      		INC YL
000224 2f21                      		MOV R18, R17
000225 2f34                      		MOV R19, R20
000226 68e0                      		ORI R30, 0x80
000227 d047                      		RCALL PID_V_MOTOR
                                 		;Se implementa la nueva salida
000228 9360 008b                 		STS OCR1BH, R22
00022a 9350 008a                 		STS OCR1BL, R21
                                 		;Se controla la dirección de giro en caso de ser necesario
00022c 8128                      		LD R18, Y ;Se lee el valor guardado
00022d fde6                      		SBRC R30, 6
00022e d032                      		RCALL INVERTIR_DIRECCION_MOTOR2
00022f b92b                      		OUT PORTD, R18
000230 17f7                      		CP R31, R23 ;Restricción de tiempo
000231 f2f8                      		BRLO LOOP_MOTORES 
                                 	FIN_PID_POS:
000232 de4e                      	RCALL DETENER
                                 	;Desactivamos las interrupciones
000233 e070                      	LDI R23, 0x00
000234 9370 006b                 	STS PCMSK0,R23
000236 9370 006d                 	STS PCMSK2,R23
                                 	;Se reinicia la cuenta del vector
000238 e0b1                      	LDI XH, HIGH($150)
000239 e5a0                      	LDI XL, LOW($150)
00023a e0d1                      	LDI YH, HIGH($150)
00023b e5c0                      	LDI YL, LOW($150)
00023c 2700                      	CLR R16
00023d 9300 0070                 	STS TIMSK2, R16;Desactivamos la bandera
00023f 930c                      	ST X, R16
000240 8308                      	ST Y, R16
000241 95c3                      	INC YL
000242 8308                      	ST Y, R16
000243 95a3                      	INC XL
000244 930c                      	ST X, R16
000245 95a3                      	INC XL
000246 930c                      	ST X, R16
000247 95a3                      	INC XL
000248 930c                      	ST X, R16
000249 2711                      	CLR R17
00024a 27bb                      	CLR R27
00024b 27cc                      	CLR R28
00024c 2766                      	CLR R22
00024d 2744                      	CLR R20
00024e 2755                      	CLR R21 
00024f 2799                      	CLR R25
000250 2788                      	CLR R24
000251 d0f7                      	RCALL Delay100ms;Delay de 100ms
000252 9508                      	RET
                                 INVERTIR_DIRECCION_MOTOR1:
000253 937f                      	PUSH R23
000254 93df                      	PUSH R29
000255 93cf                      	PUSH R28
000256 93bf                      	PUSH R27
                                 	;Si es un valor esquecífico se utiliza el valor contrario
000257 3120                      	CPI R18, 0x10
000258 f031                      	BREQ INVERTIR_M1_P1
                                 	;Si no es un valor esquecífico se utilizará este valor
000259 e120                      	LDI R18, 0x10
                                 	FIN_INVERSION_M1_P1:
00025a 91bf                      	POP R27
00025b 91cf                      	POP R28
00025c 91df                      	POP R29
00025d 917f                      	POP R23
00025e 9508                      	RET
                                 INVERTIR_M1_P1:
00025f e028                      	LDI R18, 0x08
000260 cff9                      	RJMP FIN_INVERSION_M1_P1
                                 INVERTIR_DIRECCION_MOTOR2:
000261 937f                      	PUSH R23
000262 93df                      	PUSH R29
000263 93cf                      	PUSH R28
000264 93bf                      	PUSH R27
                                 	;Si es un valor esquecífico se utiliza el valor contrario
000265 3028                      	CPI R18, 0x08
000266 f031                      	BREQ INVERTIR_M2_P1
                                 	;Si no es un valor esquecífico se utilizará este valor
000267 e028                      	LDI R18, 0x08
                                 	FIN_INVERSION_M2_P1:
000268 91bf                      	POP R27
000269 91cf                      	POP R28
00026a 91df                      	POP R29
00026b 917f                      	POP R23
00026c 9508                      	RET
                                 INVERTIR_M2_P1:
00026d e024                      	LDI R18, 0x04
00026e cff9                      	RJMP FIN_INVERSION_M2_P1
                                 PID_V_MOTOR:
                                 	;Entradas: R18 (Revoluciones)
                                 	;R19: Setpoint revolucones que debería tener
                                 	;R21:R22 salida de PWM
                                 	;R30:
                                 	;0 y 4: (set) indican si el error es negativo
                                 	;1 y 5: (set) indican si el valor guardado en la integral acumulada es negativa
                                 	;2 y 6: (set) indican si la dirección de giro del motor se invierte
                                 	;7: indica el motor con el que se opera
00026f 937f                      	PUSH R23
000270 93df                      	PUSH R29
000271 93cf                      	PUSH R28
000272 93bf                      	PUSH R27
000273 e0ca                      	LDI R28, 0x0A ;Kp (10/2)
000274 e052                      	LDI R21, 0x02
000275 e06f                      	LDI R22, 0x0F ;Ki (15/10)
000276 d027                      	RCALL ERROR_RUEDA
                                 	;Calculamos P
000277 9fc3                      	MUL R28, R19
000278 2dc0                      	MOV R28, R0
000279 2f2c                      	MOV R18,R28
00027a 2fd5                      	MOV R29, R21
00027b df35                      	RCALL DIVIDIR
00027c 2fc3                      	MOV R28, R19
                                 	;Integral de error
00027d 917c                      	LD R23, X
00027e 933c                      	ST X, R19
00027f 0f73                      	ADD R23, R19
000280 3f75                      	CPI R23, 245
000281 f4d0                      	BRSH OVER_I
                                 	CONTINUAR_PID_I:
                                 	;Leemos la integral calculada anteriormente
000282 95a3                      	INC XL
000283 915c                      	LD R21, X
000284 d02a                      	RCALL OPERACION_INTEGRAL
                                 	;Calculamos I
000285 9f76                      	MUL R23, R22
000286 2d70                      	MOV R23, R0
000287 e0da                      	LDI R29,0x0A;Ki
000288 2f27                      	MOV R18,R23
000289 df27                      	RCALL DIVIDIR
00028a 2f73                      	MOV R23, R19
                                 	;Verificamos si se tienen que invertir los motores
00028b d063                      	RCALL INVERSION_MOTOR
                                 	;Convertirmos el valor a un PWM
00028c e05a                      	LDI R21, 0x0A
00028d 9fc5                      	MUL R28, R21
00028e 2d20                      	MOV R18, R0
00028f e0d5                      	LDI R29, 0x05
000290 df20                      	RCALL DIVIDIR
000291 2fc3                      	MOV R28,R19
000292 e654                      	LDI R21, 0x64
000293 9fc5                      	MUL R28, R21
000294 2d50                      	MOV R21, R0
000295 2d61                      	MOV R22, R1
000296 d0ab                      	RCALL SATURACION
000297 91bf                      	POP R27
000298 91cf                      	POP R28
000299 91df                      	POP R29
00029a 917f                      	POP R23
00029b 9508                      	RET
                                 OVER_I:	
00029c ef75                      	LDI R23, 245
00029d cfe4                      	RJMP CONTINUAR_PID_I
                                 ERROR_RUEDA:
                                 	;Si R19 es menor a R18 el error calculado será negativo
00029e 1732                      	CP R19,R18
00029f f038                      	BRLO MINUS_ERROR
0002a0 1b32                      	SUB R19, R18;Cálculamos el error
                                 	;Si el error es positivo se debe de desactivar el bit 1 o 4
0002a1 fde7                      	SBRC R30, 7
0002a2 c002                      	RJMP INVERTIR_1
                                 	;Si trabajamos con el motor 1 desactivamos en bit 0 de R30
0002a3 7fee                      	ANDI R30,0xFE
0002a4 c001                      	RJMP FIN_ERROR
                                 	INVERTIR_1:
                                 	;Si trabajamos con el motor 1 desactivamos en bit 4 de R30
0002a5 7eef                      	ANDI R30,0xEF
                                 	FIN_ERROR:
0002a6 9508                      	RET
                                 MINUS_ERROR:
0002a7 1b23                      	SUB R18, R19
0002a8 2f32                      	MOV R19, R18
0002a9 fde7                      	SBRC R30, 7
0002aa c002                      	RJMP INVERTIR_2
                                 	;Si estamos trabajando con el motor 1 activamos el bit 0 de R30
0002ab 60e1                      	ORI R30,0x01
                                 	;Cálculamos el error
0002ac cff9                      	RJMP FIN_ERROR
                                 	INVERTIR_2:
                                 	;Si estamos trabajando con el motor 2 activamos el bit 4 de R30
0002ad 61e0                      	ORI R30,0x10
0002ae cff7                      	RJMP FIN_ERROR
                                 OPERACION_INTEGRAL:
                                 	;Operaciones con la integral positiva
                                 	;Verificamos si estamos trabajando con integrales negativas
0002af fde7                      	SBRC R30, 7
0002b0 c008                      	RJMP OPERACION_INTEGRAL_M2
0002b1 ffe7                      	SBRS R30, 7
0002b2 c002                      	RJMP OPERACION_INTEGRAL_M1
                                 	CONTINUAR_INT:
0002b3 937c                      	ST X, R23
0002b4 9508                      	RET
                                 OPERACION_INTEGRAL_M1:
                                 	;Operaciones con la integral negativa
0002b5 fde1                      	SBRC R30, 1
0002b6 c006                      	RJMP INTEGRAL_NEGATIVA
                                 	;Operaciones con la integral positiva
0002b7 ffe1                      	SBRS R30, 1
0002b8 c01d                      	RJMP INTEGRAL_POSITIVA
                                 OPERACION_INTEGRAL_M2:
                                 	;Operaciones con la integral negativa
0002b9 fde5                      	SBRC R30, 5
0002ba c002                      	RJMP INTEGRAL_NEGATIVA
                                 	;Operaciones con la integral positiva
0002bb ffe5                      	SBRS R30, 5
0002bc c019                      	RJMP INTEGRAL_POSITIVA
                                 INTEGRAL_NEGATIVA:
                                 	;Se verifica si estamos trabajando con el motor 1 o 2
0002bd ffe7                      	SBRS R30, 7
0002be c002                      	RJMP INTEGRAL_MOTOR1_N
0002bf fde7                      	SBRC R30, 7
0002c0 c004                      	RJMP INTEGRAL_MOTOR2_N
                                 INTEGRAL_MOTOR1_N:
                                 	;En el motor 1, verificamos si nuestro error es negativo o positivo
0002c1 fde0                      	SBRC R30, 0
0002c2 c006                      	RJMP RESTA_INTEGRAL_N ;Error negativo
0002c3 ffe0                      	SBRS R30, 0
0002c4 c006                      	RJMP SUMA_INTEGRAL_N ;Error positivo
                                 INTEGRAL_MOTOR2_N:
                                 	;En el motor 2, verificamos si nuestro error es negativo o positivo
0002c5 fde4                      	SBRC R30, 4
0002c6 c002                      	RJMP RESTA_INTEGRAL_N ;Error negativo
0002c7 ffe4                      	SBRS R30, 4
0002c8 c002                      	RJMP SUMA_INTEGRAL_N;Error positivo
                                 RESTA_INTEGRAL_N:
0002c9 0f75                      	ADD R23, R21 ;En la resta negativa R23 (integral actual), R21 (integral acumulada) se suma
0002ca cfe8                      	RJMP CONTINUAR_INT
                                 SUMA_INTEGRAL_N:
0002cb 1757                      	CP R21,R23 ;Si la integral acumulada es menor a la integral actual, entonces se pasará a un valor de positivo
0002cc f018                      	BRLO INT_INVERTIDA_N
0002cd 1b57                      	SUB R21, R23 ;En la suma negativa R23 (integral actual), R21 (integral acumulada) se restan
0002ce 2f75                      	MOV R23, R21
0002cf cfe3                      	RJMP CONTINUAR_INT
                                 INT_INVERTIDA_N:
                                 	;Subrutina para los dos motores
                                 	;En caso se pase de negativo a positivo se escribe '0' en los bits 1 o 5 del R30
0002d0 1b75                      	SUB R23, R21 ;En la suma negativa R23 (integral actual), R21 (integral acumulada) se restan
0002d1 ffe7                      	SBRS R30, 7
0002d2 7fed                      	ANDI R30, 0xFD
0002d3 fde7                      	SBRC R30, 7
0002d4 7def                      	ANDI R30, 0xDF
0002d5 cfdd                      	RJMP CONTINUAR_INT
                                 INTEGRAL_POSITIVA:
                                 	;Se verifica si estamos trabajando con el motor 1 o 2
0002d6 ffe7                      	SBRS R30, 7
0002d7 c002                      	RJMP INTEGRAL_MOTOR1
0002d8 fde7                      	SBRC R30, 7
0002d9 c004                      	RJMP INTEGRAL_MOTOR2
                                 INTEGRAL_MOTOR1:
                                 	;En el motor 1, verificamos si nuestro error es negativo o positivo
0002da fde0                      	SBRC R30, 0
0002db c006                      	RJMP RESTA_INTEGRAL;Error negativo
0002dc ffe0                      	SBRS R30, 0
0002dd c00f                      	RJMP SUMA_INTEGRAL;Error positivo
                                 INTEGRAL_MOTOR2:
                                 	;En el motor 2, verificamos si nuestro error es negativo o positivo
0002de fde4                      	SBRC R30, 4
0002df c002                      	RJMP RESTA_INTEGRAL;Error negativo
0002e0 ffe4                      	SBRS R30, 4
0002e1 c00b                      	RJMP SUMA_INTEGRAL;Error positivo
                                 RESTA_INTEGRAL:
0002e2 1757                      	CP R21,R23 ;Si R21 es menor a R23, se pasará a números negativos
0002e3 f018                      	BRLO INT_INVERTIDA
0002e4 1b57                      	SUB R21, R23 ;En la resta se trabaja con R23 (integral actual), R21 (integral acumulada)
0002e5 2f75                      	MOV R23, R21
0002e6 cfcc                      	RJMP CONTINUAR_INT
                                 INT_INVERTIDA:
                                 	;Subrutina para los dos motores
                                 	;En caso se pase de negativo a positivo se escribe '1' en los bits 1 o 5 del R30
0002e7 1b75                      	SUB R23, R21 ;En la resta se trabaja con R23 (integral actual), R21 (integral acumulada)
0002e8 ffe7                      	SBRS R30, 7
0002e9 60e2                      	ORI R30, 0x02
0002ea fde7                      	SBRC R30, 7
0002eb 62e0                      	ORI R30, 0x20
0002ec cfc6                      	RJMP CONTINUAR_INT
                                 SUMA_INTEGRAL:
