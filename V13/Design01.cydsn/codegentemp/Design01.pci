# Design01
# 2024-08-26 05:07:23Z

# IO_0@[IOP=(1)][IoId=(0)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 0
# IO_1@[IOP=(1)][IoId=(1)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 1
# IO_3@[IOP=(1)][IoId=(3)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 3
set_io "Rx_1(0)" iocell 12 6
set_io "Tx_1(0)" iocell 12 7
set_io "Vout_1(0)" iocell 0 1
set_io "INVERSOR_1(0)" iocell 0 3
set_io "SENSOR_1(0)" iocell 0 2
set_io "Vout_2(0)" iocell 3 7
set_io "SENSOR_2(0)" iocell 3 3
set_io "INVERSOR_3(0)" iocell 0 5
set_io "SENSOR_3(0)" iocell 0 4
set_io "Vout_3(0)" iocell 0 0
set_io "DIGITOS(0)" iocell 2 4
set_io "DIGITOS(1)" iocell 2 5
set_io "DIGITOS(2)" iocell 2 6
set_io "DIGITOS(3)" iocell 2 7
set_io "INVERSOR_2(0)" iocell 3 2
set_io "BOTONES(0)" iocell 0 6
set_io "BOTONES(1)" iocell 0 7
set_io "LED_MSB(0)" iocell 2 0
set_io "BOTON(0)" iocell 2 2
set_io "SS_A(0)" iocell 1 2
set_io "SS_B(0)" iocell 12 3
set_io "SS_C(0)" iocell 12 2
set_io "SS_D(0)" iocell 2 3
set_io "SS_E(0)" iocell 1 4
set_io "SS_F(0)" iocell 1 5
set_io "SS_G(0)" iocell 1 6
set_io "SS_P(0)" iocell 1 7
set_io "LED_LSB(0)" iocell 12 5
set_location "\Opamp_1:ABuf\" abufcell -1 -1 0
