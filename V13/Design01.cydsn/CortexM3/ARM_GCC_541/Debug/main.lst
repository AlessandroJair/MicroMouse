  72:main.c        **** uint8 SSeg(uint8 value) {
  73:main.c        **** 	// Función que convierte un valor numérico a un patrón de bits para controlar el display de 7 s
  74:main.c        **** 	uint8 result;
  75:main.c        **** 
  76:main.c        ****     switch(value) {
  77:main.c        **** 		case 0:
  78:main.c        **** 		result = 0b00000110;
  79:main.c        **** 		break;
  80:main.c        **** 		case 1:
  81:main.c        **** 		result = 0b10011010;
  82:main.c        **** 		break;
  83:main.c        **** 		case 2:
  84:main.c        **** 		result = 0b00100000;
  85:main.c        **** 		break;
  86:main.c        **** 		case 3:
  87:main.c        **** 		result = 0b00001000;
ARM GAS  C:\Users\ALESSA~1\AppData\Local\Temp\ccTnXUCt.s 			page 3


  88:main.c        **** 		break;
  89:main.c        **** 		case 4:
  90:main.c        **** 		result = 0b10011100;
  91:main.c        **** 		break;
  92:main.c        **** 		case 5:
  93:main.c        **** 		result = 0b01001100;
  94:main.c        **** 		break;
  95:main.c        **** 		case 6:
  96:main.c        **** 		result = 0b01000100;
  97:main.c        **** 		break;
  98:main.c        **** 		case 7:
  99:main.c        **** 		result = 0b00011010;
 100:main.c        **** 		break;
 101:main.c        **** 		case 8:
 102:main.c        **** 		result = 0b00000100;
 103:main.c        **** 		break;
 104:main.c        **** 		case 9:
 105:main.c        **** 		result = 0b00011100;
 106:main.c        **** 		break;
 107:main.c        **** 		default:
 108:main.c        **** 		result = 0; // Valor por defecto si no se encuentra el caso
 109:main.c        **** 	}
 110:main.c        ****     return result;
 111:main.c        **** }
